"""The target answers what it declares, and declines what it cannot reach."""

from pathlib import Path

from guardana.core.target import LocatorError, TargetKind
from guardana.testing import assert_target_conforms

from __MODULE__.target import __CLASS__Target
import pytest


def test_the_target_conforms_to_what_it_declares(tmp_path: Path) -> None:
    (tmp_path / "note.txt").write_text("hello")

    assert_target_conforms(__CLASS__Target(tmp_path))


def test_a_directory_that_is_not_there_is_refused_rather_than_assumed_empty() -> None:
    with pytest.raises(LocatorError):
        __CLASS__Target.from_locator("/no/such/directory", options={})


def test_an_unknown_option_is_refused(tmp_path: Path) -> None:
    with pytest.raises(LocatorError):
        __CLASS__Target.from_locator(str(tmp_path), options={"depth": "2"})


def test_a_missing_directory_is_a_check_that_did_not_run_not_a_clean_one() -> None:
    """A target that cannot see anything must not look like one that saw nothing wrong."""
    target = __CLASS__Target("/no/such/directory")

    assert list(target.iter_files()) == []
    assert target.unread_sources(), "a directory nobody could read must not read as clean"
    assert target.kind is TargetKind.ARTIFACT
